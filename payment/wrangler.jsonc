// Cloudflare Worker (free plan) serving https://payment.lekopien.com
// In Cloudflare, set this folder ("payment") as the project's root directory.
{
  "name": "lekopien-payment",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "." },
  "routes": [{ "pattern": "payment.lekopien.com", "custom_domain": true }]
}
