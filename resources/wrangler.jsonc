// Cloudflare Worker (free plan) serving https://resources.lekopien.com
// In Cloudflare, set this folder ("resources") as the project's root directory.
{
  "name": "lekopien-resources",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "." },
  "routes": [{ "pattern": "resources.lekopien.com", "custom_domain": true }]
}
